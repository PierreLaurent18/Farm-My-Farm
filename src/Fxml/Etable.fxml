<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane fx:controller="Controller.EtableController" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
            <Label text="🏡 MON ÉTABLE" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    <center>
        <GridPane fx:id="stableGrid" alignment="CENTER" hgap="10" vgap="10" />
    </center>
    <bottom>
        <!-- fx:id corrigé : animalChoiceBox (cohérent avec EtableController) -->
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
            <ChoiceBox fx:id="animalChoiceBox" prefWidth="150.0" />
            <Label fx:id="etableCowLabel"   text="Vaches : 0" />
            <Label fx:id="etableSheepLabel" text="Moutons : 0" />
            <Button text="Fermer" onAction="#closeWindow" />
        </VBox>
    </bottom>
</BorderPane>
